import type { CSSProperties } from "react";

type BrandLogoProps = {
    compact?: boolean;
    className?: string;
    style?: CSSProperties;
};

export default function BrandLogo({
    compact = false,
    className = "",
    style,
}: BrandLogoProps) {
    return (
        <a
            href="/dashboard"
            aria-label="FinPay dashboard"
            className={`finpay-brand ${className}`.trim()}
            style={{
                display: "inline-flex",
                alignItems: "center",
                gap: compact ? "0" : "12px",
                textDecoration: "none",
                minWidth: 0,
                ...style,
            }}
        >
            <img
                src="/brand/finpay-logo.png"
                alt="FinPay — Manage, Pay, Grow"
                style={{
                    display: "block",
                    width: compact ? "44px" : "164px",
                    maxWidth: "100%",
                    height: "auto",
                    objectFit: "contain",
                }}
            />
        </a>
    );
}
